# Adaptador de datos: "supabase" (por defecto) o "local" (solo desarrollo y pruebas E2E).
KAIRO_ADAPTADOR=supabase

# Supabase — valores públicos del proyecto (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para `npm run sembrar:supabase` (se ejecuta en tu máquina, nunca en el navegador).
# SUPABASE_SERVICE_ROLE_KEY=

# Adaptador local: secreto para firmar la cookie de sesión.
# KAIRO_SECRETO_LOCAL=cambia-esto
